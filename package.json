{
  "name": "running-tab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui,worker \"npm:dev:api\" \"npm:dev:ui\" \"npm:worker\"",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 1420",
    "desktop": "tauri dev",
    "desktop:build": "npm run brand:sync && tauri build",
    "worker": "tsx --env-file=.env server/worker.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx --env-file=.env scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file=.env server/index.ts",
    "test": "tsx --env-file=.env scripts/test.ts",
    "test:e2e": "playwright test",
    "test:rust": "cargo test -p tab-core",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "brand:sync": "tsx scripts/brand.ts",
    "format": "prettier --write src server shared scripts tests docs *.{ts,json,yml} README.md",
    "test:cli": "cargo build -p tab-cli --locked && tsx --env-file=.env scripts/check-cli.ts",
    "test:seed": "tsx --env-file=.env scripts/check-seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.5",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.104.0",
    "@tauri-apps/api": "2.12.1",
    "better-auth": "1.7.7",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "lucide-react": "1.49.0",
    "nodemailer": "10.0.13",
    "openai": "7.25.0",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
