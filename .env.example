NODE_ENV=development
DATABASE_URL=postgres://runningtab:runningtab@127.0.0.1:55432/runningtab
APP_URL=http://localhost:1420
API_PORT=3001
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BILLING_MODE=demo
DEMO_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Running Tab <hello@runningtab.test>
# Optional; no external credentials are needed for demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
AI_MODEL=
# Stable demo clock override, YYYY-MM-DD; omit to seed relative to today.
DEMO_REFERENCE_DATE=
# Desktop: set at build/run time, never to an untrusted host.
RUNNING_TAB_API_URL=http://localhost:3001
